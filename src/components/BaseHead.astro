---
import { siteConfig } from "@/config/site";
import { withBase } from "@/utils/urls";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.socialImage,
  type = "website",
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const socialImageUrl = image
  ? new URL(withBase(image), Astro.site ?? Astro.url)
  : undefined;
const profileUrl = new URL(withBase(), Astro.site ?? Astro.url);
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: profileUrl.href,
  jobTitle: siteConfig.role,
  email: `mailto:${siteConfig.email}`,
  affiliation: {
    "@type": "Organization",
    name: siteConfig.affiliation,
  },
  sameAs: siteConfig.socialLinks.map((link) => link.url),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f7f7f3" />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
<link rel="manifest" href={withBase("site.webmanifest")} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:alt" content={siteConfig.socialImageAlt} />}
{socialImageUrl && <meta property="og:image:width" content="1200" />}
{socialImageUrl && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{socialImageUrl && <meta name="twitter:image:alt" content={siteConfig.socialImageAlt} />}

<script type="application/ld+json" set:html={JSON.stringify(personStructuredData)} is:inline />
