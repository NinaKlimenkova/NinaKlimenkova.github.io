---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { withBase } from "@/utils/urls";

interface Props {
  entry: CollectionEntry<"news">;
  headingLevel?: "h2" | "h3";
}

const { entry, headingLevel = "h2" } = Astro.props;
const { Content } = await render(entry);
const Heading = headingLevel;
const formattedDate = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(entry.data.date);

function resolveHref(href: string): string {
  return /^https?:\/\//.test(href) ? href : withBase(href);
}
---

<article class="news-entry">
  <p class="news-entry__date">
    <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
  </p>
  <Heading>{entry.data.title}</Heading>
  <p>{entry.data.summary}</p>
  <div class="news-entry__body">
    <Content />
  </div>
  {entry.data.url && <a href={resolveHref(entry.data.url)}>Read more</a>}
</article>

<style>
  .news-entry {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .news-entry:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .news-entry__date {
    margin-bottom: var(--space-2);
  }

  .news-entry h2,
  .news-entry h3 {
    margin-bottom: var(--space-3);
  }

  .news-entry__body :global(> :last-child) {
    margin-bottom: var(--space-3);
  }
</style>
