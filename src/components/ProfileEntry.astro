---
import type { DatedProfileEntry } from "@/data/profile";

interface Props {
  entry: DatedProfileEntry;
  headingLevel?: "h2" | "h3";
}

const { entry, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="profile-entry">
  <div class="profile-entry__heading">
    <div>
      <Heading>{entry.title}</Heading>
      <p class="profile-entry__organization">{entry.organization}</p>
    </div>
    <p class="profile-entry__date">{entry.date}</p>
  </div>
  {entry.description && <p>{entry.description}</p>}
  {
    entry.details && entry.details.length > 0 && (
      <ul>
        {entry.details.map((detail) => <li>{detail}</li>)}
      </ul>
    )
  }
</article>

<style>
  .profile-entry {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .profile-entry:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .profile-entry__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .profile-entry h2,
  .profile-entry h3,
  .profile-entry__organization,
  .profile-entry__date {
    margin-bottom: 0;
  }

  .profile-entry__date {
    flex: 0 0 auto;
  }

  .profile-entry > :last-child {
    margin-bottom: 0;
  }

  @media (max-width: 40rem) {
    .profile-entry__heading {
      display: block;
    }

    .profile-entry__date {
      margin-top: var(--space-2);
    }
  }
</style>
