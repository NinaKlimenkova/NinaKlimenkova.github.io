---
interface Props {
  items: string[];
  label?: string;
}

const { items, label = "Topics" } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="tag-list" aria-label={label}>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
</style>
