---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/urls";
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="page-section">
    <div class="layout-container page-intro">
      <h1>404 · Page not found</h1>
      <p>The page may have moved, or the address may be incomplete.</p>
      <div class="button-row">
        <a class="button-link" href={withBase()}>Return home</a>
      </div>
    </div>
  </section>
</BaseLayout>
