---
import ProfileEntry from "@/components/ProfileEntry.astro";
import { siteConfig } from "@/config/site";
import { academicProfile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/urls";
---

<BaseLayout
  title="CV"
  description="Education, research experience, academic service, mentoring, and selected technical skills for Nina Klimenkova."
>
  <section class="page-section" aria-labelledby="cv-download">
    <div class="layout-container">
      <div class="cv-panel">
        <div>
          <p class="eyebrow">Complete record</p>
          <h1 id="cv-download">Curriculum vitae</h1>
        </div>
        <a class="button-link" href={withBase(siteConfig.cvPath)} download>Download CV (PDF)</a>
      </div>
    </div>
  </section>

  <header class="page-section">
    <div class="layout-container cv-section">
      <p class="eyebrow">Web version</p>
      <h2>CV summary</h2>
    </div>
  </header>

  <section class="page-section" aria-labelledby="education">
    <div class="layout-container cv-section">
      <p class="eyebrow">Academic background</p>
      <h2 id="education">Education</h2>
      {academicProfile.education.map((entry) => <ProfileEntry entry={entry} />)}
    </div>
  </section>

  <section class="page-section" aria-labelledby="research-experience">
    <div class="layout-container cv-section">
      <p class="eyebrow">Current appointment</p>
      <h2 id="research-experience">Research experience</h2>
      <ProfileEntry entry={academicProfile.researchRole} />
    </div>
  </section>

  <section class="page-section" aria-labelledby="service-mentoring">
    <div class="layout-container cv-section">
      <p class="eyebrow">Selected activities</p>
      <h2 id="service-mentoring">Service and mentoring</h2>
      <ProfileEntry entry={academicProfile.mentoring} />
      <ProfileEntry entry={academicProfile.service} />
    </div>
  </section>

  <section class="page-section" aria-labelledby="skills">
    <div class="layout-container cv-section">
      <p class="eyebrow">Technical profile</p>
      <h2 id="skills">Programming languages and tools</h2>
      <dl class="skills-list">
        <div>
          <dt>Programming</dt>
          <dd>{academicProfile.skills.programming.join(", ")}</dd>
        </div>
        <div>
          <dt>Tools and frameworks</dt>
          <dd>{academicProfile.skills.tools.join(", ")}</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .cv-panel > div,
  .cv-section {
    max-width: 62rem;
  }

  .cv-panel h1 {
    margin-bottom: 0;
    font-size: var(--text-2xl);
  }

  .cv-section > h2 {
    margin-bottom: var(--space-5);
  }

  .skills-list {
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .skills-list div {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .skills-list dt {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .skills-list dd {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .cv-panel {
      align-items: flex-start;
      flex-direction: column;
      padding: var(--space-5);
    }

    .skills-list div {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
